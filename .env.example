# ========================================================
# ZapShift Frontend Environment Variables Template
# ========================================================

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
# Production: NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.vercel.app/api

# NextAuth v5 Configuration (Server-side)
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000
# Production: NEXTAUTH_URL=https://your-frontend-domain.vercel.app
AUTH_TRUST_HOST=true

# Google OAuth Credentials (Server-side only - Never use NEXT_PUBLIC_)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Client-side Public Services
NEXT_PUBLIC_IMGBBB_API_KEY=your_imgbb_api_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
